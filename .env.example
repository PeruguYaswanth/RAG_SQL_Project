# PostgreSQL Connection String (Standard format, e.g., postgresql://user:password@host:port/dbname)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_sql_db

# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Upload & File Limits
MAX_UPLOAD_MB=10
CSV_CHUNK_THRESHOLD_MB=2
BATCH_SIZE=500

# Session Expiry & Query Safety
SESSION_TTL_SECONDS=3600
STATEMENT_TIMEOUT_MS=5000
